{
  "name": "armador-horarios",
  "version": "2.0.0",
  "description": "Armador de Horarios Inteligente para estudiantes universitarios",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint src/ tests/",
    "format": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "format:fix": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "keywords": [
    "horarios",
    "upao",
    "universidad",
    "planificador",
    "backtracking"
  ],
  "author": "Alessandro Ramos",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0"
  }
}
